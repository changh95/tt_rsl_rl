{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/tray_guard.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Edit(//home/ttuser/experiments/rsl_rl/.claude/**)",
      "Write(//home/ttuser/experiments/rsl_rl/.claude/**)",
      "NotebookEdit(//home/ttuser/experiments/rsl_rl/.claude/**)",
      "Edit(//home/ttuser/experiments/rsl_rl/scripts/tray_env.sh)",
      "Write(//home/ttuser/experiments/rsl_rl/scripts/tray_env.sh)",
      "Edit(/.claude/**)",
      "Write(/.claude/**)",
      "NotebookEdit(/.claude/**)",
      "Edit(/scripts/tray_env.sh)",
      "Write(/scripts/tray_env.sh)",
      "Edit(.claude/**)",
      "Write(.claude/**)",
      "NotebookEdit(.claude/**)",
      "Edit(scripts/tray_env.sh)",
      "Write(scripts/tray_env.sh)"
    ]
  }
}
